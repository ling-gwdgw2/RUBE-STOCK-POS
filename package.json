{
  "name": "rube-stock-pos-monorepo",
  "version": "3.1.1",
  "type": "module",
  "private": true,
  "description": "RUBE-STOCK-POS v3.1 Unified Local-First Warehouse & POS System Monorepo",
  "workspaces": [
    "packages/shared-contracts",
    "packages/core-engine",
    "packages/hal-drivers",
    "packages/cluster-gateway",
    "packages/ui-presentation"
  ],
  "scripts": {
    "start": "node scripts/start-pos-app.ts",
    "desktop:clean-start": "node scripts/start-pos-app.ts --clean-start",
    "build:installer": "node scripts/build-desktop-installer.ts",
    "dev:ui": "vite --config packages/ui-presentation/vite.config.mjs",
    "build:ui": "vite build --config packages/ui-presentation/vite.config.mjs",
    "tauri:dev": "cargo run --manifest-path src-tauri/Cargo.toml",
    "tauri:build": "npx tauri build",
    "test": "node --test tests/property-invariants/accounting-invariants.test.ts tests/e2e-integration/phase0-assembly.test.ts tests/e2e-integration/phase1-warehouse-assembly.test.ts tests/e2e-integration/phase2-pos-assembly.test.ts tests/e2e-integration/phase3-cluster-resilience-assembly.test.ts tests/e2e-integration/phase4-security-chaos-soak-assembly.test.ts tests/e2e-integration/phase5-production-release-assembly.test.ts tests/e2e-integration/section6-hil-assembly-checklist.test.ts tests/e2e-integration/phase6-interactive-ui-server.test.ts",
    "test:invariants": "node --test tests/property-invariants/accounting-invariants.test.ts",
    "test:phase0": "node --test tests/e2e-integration/phase0-assembly.test.ts",
    "test:phase1": "node --test tests/e2e-integration/phase1-warehouse-assembly.test.ts",
    "test:phase2": "node --test tests/e2e-integration/phase2-pos-assembly.test.ts",
    "test:phase3": "node --test tests/e2e-integration/phase3-cluster-resilience-assembly.test.ts",
    "test:phase4": "node --test tests/e2e-integration/phase4-security-chaos-soak-assembly.test.ts",
    "test:phase5": "node --test tests/e2e-integration/phase5-production-release-assembly.test.ts",
    "test:hil": "node --test tests/e2e-integration/section6-hil-assembly-checklist.test.ts",
    "test:ui-server": "node --test tests/e2e-integration/phase6-interactive-ui-server.test.ts",
    "test:rust": "cargo test",
    "verify:schema": "node scripts/verify-schema-checksum.mjs",
    "verify:pr-gatekeeping": "node scripts/verify-pr-gatekeeping.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.479.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
