{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "paths": {
      "@rube-pos/shared-contracts": ["./packages/shared-contracts/src/index.ts"],
      "@rube-pos/hal-drivers": ["./packages/hal-drivers/src/index.ts"]
    }
  }
}

