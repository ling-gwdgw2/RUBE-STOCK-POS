{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RUBE-STOCK-POS",
  "version": "3.1.1",
  "identifier": "com.rube.stockpos",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../packages/ui-presentation/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
